rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedCaregiver(patientId) {
      return isSignedIn()
        && (
          (exists(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.memberId == request.auth.uid
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.patientId == patientId
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.role == 'caregiver'
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.status in ['Active', 'accepted'])
          ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'caregiver'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId == patientId)
        );
    }

    function canManagePatientPrescriptions(patientId) {
      return isSignedIn()
        && (request.auth.uid == patientId
          || isLinkedCaregiver(patientId)
          || (exists(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.memberId == request.auth.uid
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.patientId == patientId
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.role == 'doctor'
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.status in ['Active', 'accepted']));
    }

    function isActivePharmacist(patientId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.memberId == request.auth.uid
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.patientId == patientId
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.role == 'pharmacist'
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.status in ['Active', 'accepted'];
    }

    function canManagePatientMedicines(patientId) {
      return canManagePatientPrescriptions(patientId) || isActivePharmacist(patientId);
    }

    function isActiveCareTeamMember(patientId) {
      return isSignedIn()
        && (
          (exists(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.memberId == request.auth.uid
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.patientId == patientId
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.role in ['caregiver', 'nurse', 'doctor']
            && get(/databases/$(database)/documents/care_links/$(patientId + '_' + request.auth.uid)).data.status in ['Active', 'accepted'])
          ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'caregiver'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId == patientId)
        );
    }

    function isActiveCaregiverFor(patientId, caregiverId) {
      return exists(/databases/$(database)/documents/care_links/$(patientId + '_' + caregiverId))
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + caregiverId)).data.patientId == patientId
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + caregiverId)).data.memberId == caregiverId
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + caregiverId)).data.role == 'caregiver'
        && get(/databases/$(database)/documents/care_links/$(patientId + '_' + caregiverId)).data.status in ['Active', 'accepted'];
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || (resource.data.role == 'patient' && isActiveCareTeamMember(userId)));
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && !('password' in request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !('password' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'age', 'email', 'phone', 'address', 'emergencyContact',
          'language', 'largeText', 'highContrast', 'voiceReminders',
          'profileImageUrl'
        ]);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /medicines/{medicineId} {
      allow read: if canManagePatientMedicines(resource.data.patientId)
        || isActiveCareTeamMember(resource.data.patientId);
      allow delete: if canManagePatientMedicines(resource.data.patientId);
      allow create: if canManagePatientMedicines(request.resource.data.patientId)
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.patientId != null;
      allow update: if canManagePatientMedicines(resource.data.patientId)
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'dose', 'mealInstruction', 'notes', 'stockDays',
          'active', 'refillStatus', 'deleted', 'deletedAt'
        ]);
    }

    match /reminder_times/{reminderId} {
      allow read, update, delete: if canManagePatientMedicines(resource.data.patientId);
      allow create: if canManagePatientMedicines(request.resource.data.patientId);
    }

    match /refill_summary/{summaryId} {
      allow read, update, delete: if canManagePatientMedicines(resource.data.patientId);
      allow create: if canManagePatientMedicines(request.resource.data.patientId);
    }

    match /prescriptions/{prescriptionId} {
      allow read, delete: if canManagePatientPrescriptions(resource.data.patientId);
      allow create: if canManagePatientPrescriptions(request.resource.data.patientId)
        && request.auth.uid == request.resource.data.userId
        && request.auth.uid == request.resource.data.addedBy;
      allow update: if canManagePatientPrescriptions(resource.data.patientId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.addedByRole == resource.data.addedByRole;
    }

    match /care_notes/{noteId} {
      allow read: if isSignedIn()
        && ((request.auth.uid == resource.data.patientId
              && resource.data.visibleToPatient == true)
          || isActiveCareTeamMember(resource.data.patientId));
      allow create: if isActiveCareTeamMember(request.resource.data.patientId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorRole in ['caregiver', 'nurse', 'doctor'];
      allow update: if isActiveCareTeamMember(resource.data.patientId)
        && resource.data.authorId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorRole == resource.data.authorRole;
      allow delete: if isActiveCareTeamMember(resource.data.patientId)
        && resource.data.authorId == request.auth.uid;
    }

    match /lab_tests/{testId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.patientId
          || isActiveCareTeamMember(resource.data.patientId));
      allow create: if isActiveCareTeamMember(request.resource.data.patientId)
        && request.resource.data.orderedBy == request.auth.uid;
      allow update, delete: if isActiveCareTeamMember(resource.data.patientId)
        && resource.data.orderedBy == request.auth.uid;
    }

    match /care_links/{linkId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.patientId
          || request.auth.uid == resource.data.memberId
          || isActiveCareTeamMember(resource.data.patientId));
      allow create: if request.auth != null
        && request.resource.data.role in ['caregiver', 'nurse', 'doctor', 'pharmacist']
        && exists(/databases/$(database)/documents/users/$(request.resource.data.patientId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.patientId)).data.role == 'patient'
        && (
          request.auth.uid == request.resource.data.patientId
          || (request.resource.data.role in ['nurse', 'doctor', 'pharmacist']
            && isLinkedCaregiver(request.resource.data.patientId))
        );
      allow update: if request.auth != null
        && request.resource.data.role in ['caregiver', 'nurse', 'doctor', 'pharmacist']
        && (
          request.auth.uid == resource.data.patientId
          || (request.auth.uid == resource.data.memberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['Active', 'accepted', 'Declined', 'declined'])
          || (resource.data.role == 'nurse'
            && isLinkedCaregiver(resource.data.patientId)
            && request.resource.data.patientId == resource.data.patientId
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status in ['Pending', 'pending']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'memberName', 'email', 'status', 'permissions', 'addedBy', 'createdAt'
            ]))
        );
      allow delete: if request.auth != null
        && resource.data.role in ['caregiver', 'nurse', 'doctor', 'pharmacist']
        && (
          request.auth.uid == resource.data.patientId
          || request.auth.uid == resource.data.memberId
          || isLinkedCaregiver(resource.data.patientId)
        );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isActiveCareTeamMember(request.resource.data.patientId)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.userId == request.resource.data.patientId
          || isActiveCaregiverFor(
            request.resource.data.patientId,
            request.resource.data.userId
          ));
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /publicProfiles/{profileId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == profileId;
      allow delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read, write: if ![
        'users',
        'medicines',
        'prescriptions',
        'care_notes',
        'lab_tests',
        'care_links',
        'notifications',
        'publicProfiles'
      ].hasAny([collectionName]);
    }
  }
}
